# Copy this file to .env and fill in real values before starting the server.

PORT=4000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Setu (Pinelabs) KYC credentials — get these after sandbox sign-up at https://bridge.setu.co/v2/
# Starter plan pricing confirmed 2026-09-29. Sandbox base URL below is correct per
# docs.setu.co as of 2026-09-30; switch to https://dg.setu.co for production.
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# Gemini vision API for automated punch-selfie face-match — NOT a certified biometric
# face-match/liveness API, just an LLM vision judgement call (see geminiClient.js for
# the honest caveats). Get a free self-serve key at https://aistudio.google.com/apikey
# (no sales process, unlike Setu). Leave blank to disable — punches then skip the face
# check entirely and only the manual HR photo-compare view applies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Where SQLite writes its data file. Defaults to ./data if unset.
DATA_DIR=

# Admin portal login is email + each user's own password (no OTP). The first System
# Admin(s) are created at start-up from these two values: comma-separated emails, and the
# temporary password they sign in with (they are made to change it at first login; once
# changed, these values are never applied again). After that, a System Admin creates every
# other admin-portal user — with role, site/vendor scope and a temporary password — from
# the Users screen. Nothing is ever auto-created at login, on any server.
ADMIN_BOOTSTRAP_EMAILS=
ADMIN_BOOTSTRAP_PASSWORD=

# UIDAI's public certificate for Aadhaar Secure QR offline verification (the .cer from
# uidai.gov.in → Ecosystem → Aadhaar Paperless Offline e-KYC / Secure QR). When set, a
# scanned Aadhaar QR whose signature doesn't verify is rejected as forged. When blank,
# the QR is still decoded (pre-fill + cross-check against DigiLocker) but not trusted
# on its own — Aadhaar is only marked verified after the DigiLocker (OTP) step anyway.
AADHAAR_QR_CERT_PATH=

# ---- Outgoing messages (services/notify.js). Leave blank and messages are only logged. ----
# Email (OTP for admin login, automatic report emails R15, security alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS (worker OTP, approval / send-back SMS): POST {to, message} to this URL
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# WhatsApp via WATI: the manager's daily email copy (R21), and login OTPs.
# OTPs go WhatsApp-first, SMS fallback (SMS_WEBHOOK_URL above) — a worker without
# WhatsApp on that number still gets in. WATI_OTP_TEMPLATE is the name of a
# Meta-approved AUTHENTICATION-category template in WATI with one variable {{1}} = the
# code; without it (or without an SMS gateway) OTPs can't be delivered and no worker can
# log in once NODE_ENV=production.
WATI_API_URL=
WATI_API_TOKEN=
WATI_OTP_TEMPLATE=
# Set to 1 to stop the automatic-email scheduler (e.g. on a second server instance)
DISABLE_EMAIL_SCHEDULER=

# ---- Daily database backup (BRD §9) ----
# Put backups on a different disk / mounted storage in production.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_IST=2
DISABLE_BACKUP_SCHEDULER=
