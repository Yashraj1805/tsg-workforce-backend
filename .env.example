# Copy this file to .env and fill in real values before starting the server.

PORT=4000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Setu (Pinelabs) KYC credentials — get these after sandbox sign-up at https://bridge.setu.co/v2/
# Starter plan pricing confirmed 2026-09-29. Sandbox base URL below is correct per
# docs.setu.co as of 2026-09-30; switch to https://dg.setu.co for production.
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# Gemini vision API for automated punch-selfie face-match — NOT a certified biometric
# face-match/liveness API, just an LLM vision judgement call (see geminiClient.js for
# the honest caveats). Get a free self-serve key at https://aistudio.google.com/apikey
# (no sales process, unlike Setu). Leave blank to disable — punches then skip the face
# check entirely and only the manual HR photo-compare view applies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Where SQLite writes its data file. Defaults to ./data if unset.
DATA_DIR=

# SMTP for the automatic reports (R15) — My team today, site summary, blocked punches,
# etc. Any SMTP provider works (a Google Workspace account, SES, SendGrid SMTP...).
# Leave blank to run in dev mode: reports still compute and log to the console/
# server.log, just without actually sending — see emailService.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Business API provider for R21 (WhatsApp copy of the manager's daily email) —
# not sourced yet. Leave blank to log instead of sending (see whatsappService.js).
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Set to 'true' to stop the R15 cron jobs from registering at boot (e.g. for local dev
# where you don't want 7 scheduled emails firing in the background).
DISABLE_SCHEDULER=
